# Fetched inputs (scripts/fetch_dataset.py, scripts/setup_repos.py)
data/
repos/
/repos-pro/

# Third-party files fetched at a pin, never shipped (scripts/fetch_vendor.sh)
/vendor/wheels/
/viz/static/vendor/

# Lean workspace build artifacts (install.sh)
lean_shared/.lake/
lean_shared/build.log
**/.lake/

# Run artifacts (regenerable). No negative pattern here, so anything tracked
# under experiments/ arrived by force-add, and all of it belongs to the Pro lane
# under pro2026/: the drivers that lane runs, the evidence behind particular
# decisions it published, and -- the reason the exception exists -- pbt_verify.py
# and pbt_drop_divergence.py, which 347 published Pro batteries cite as the tool
# that produced their evidence, most of them by that exact path, so neither moves.
experiments/
/logs/

# The DEFAULT corpus root (paths.TASKS_ROOT with SBU_BENCHMARK_DIR unset). The
# two shipped corpora are benchmark-verified/ and benchmark-pro/, so anything
# here is a local build, and a fresh checkout's first `construct` run should not
# leave the tree dirty. Root-anchored so it cannot match either shipped corpus.
/benchmark/

__pycache__/
*.pyc
*.egg-info/
.conda/
CLAUDE.md

# Review-site operational data (comments DB; export via viz/export_comments.py)
viz/data/

# Scratch that belongs in a temp dir rather than the checkout. Root-anchored
# (`/`) on purpose: an unanchored `*.lean` would swallow the corpus's own
# Solution.lean. tests/test_repo_hygiene.py asserts both halves.
/.scratch*/
/*scratch*/
/*SCRATCH*/
/*.lean
/*.olean
/*.log
/*.exit
/*.err
/*.out
/probe_*
/hs_err_pid*.log
/sbu_patch.*.json
/atkdbg.*.json
/*.whl

# NFS silly-rename: a deleted-but-still-open file reappears as `.nfsXXXX`.
.nfs*

# Per-cell claim taken by the port/audit drivers; never part of a bundle
.pbt_port.lock
