# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
build-check/
dist/
.eggs/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
site/

# Local environment
.env
.venv/
venv/

# Editor settings
.vscode/
.idea/

# Runtime output. Anchored to the repository root on purpose: a run writes these here,
# and an unanchored rule would also hide packaged data with the same name anywhere under
# src/ -- which is how the smoke fixture corpus once went missing from a fresh clone.
/bundles/
/cassettes/
/.toolchains/
/.benchproofer-cache/
/reports/
/smoke-out/
*.log
